# Native local run (Windows). Copy to repo-root .env.local (gitignored).
# Do NOT use deploy/.env — that file is Compose / 线上, hosts are mysql / redis.
# Shared LAN middleware: MySQL 8 + Redis 6.0.8 / DB 2. MUST NOT use db0.

# JDBC. characterEncoding MUST be UTF-8 (Java charset). Server charset stays utf8mb4.
MKT_DATASOURCE_URL=jdbc:mysql://192.168.88.149:3308/mkt_platform?characterEncoding=UTF-8&connectionTimeZone=UTC&allowPublicKeyRetrieval=true&useSSL=false
MKT_DATASOURCE_USERNAME=mkt
MKT_DATASOURCE_PASSWORD=CHANGE_ME_APP

# Flyway (admin-app only). portal stays MKT_FLYWAY_ENABLED=false via the launcher.
MKT_FLYWAY_USER=mkt
MKT_FLYWAY_PASSWORD=CHANGE_ME_APP

REDIS_HOST=192.168.88.149
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS
REDIS_DATABASE=2
MKT_REDIS_HOST=192.168.88.149
MKT_REDIS_PORT=6379
MKT_REDIS_PASSWORD=CHANGE_ME_REDIS
MKT_REDIS_DATABASE=2

MKT_SA_TOKEN_JWT_SECRET=CHANGE_ME_SESSION
MKT_INTERNAL_APP_AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MKT_INIT_ADMIN_PASSWORD=CHANGE_ME_Admin1n!
MKT_ALERT_WEBHOOK_URL=
