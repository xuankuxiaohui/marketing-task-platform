<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mkt.ad.mapper.AdPositionMapper">

    <sql id="cols">
        id, code, name, form, platforms, status, deleted, created_by, created_at, updated_at
    </sql>

    <sql id="queryWhere">
        <where>
            deleted = 0
            <if test="code != null and code != ''">
                AND code = #{code}
            </if>
            <if test="form != null and form != ''">
                AND form = #{form}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </sql>

    <select id="selectByCode" resultType="com.mkt.ad.entity.AdPositionEntity">
        SELECT <include refid="cols"/>
        FROM ad_position
        WHERE code = #{code} AND deleted = 0
    </select>

    <select id="selectCountByQuery" resultType="long">
        SELECT COUNT(*)
        FROM ad_position
        <include refid="queryWhere"/>
    </select>

    <select id="selectByQuery" resultType="com.mkt.ad.entity.AdPositionEntity">
        SELECT <include refid="cols"/>
        FROM ad_position
        <include refid="queryWhere"/>
        ORDER BY id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>
</mapper>
