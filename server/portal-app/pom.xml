<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mkt</groupId>
        <artifactId>platform-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>portal-app</artifactId>
    <name>portal-app</name>

    <dependencies>
        <dependency>
            <groupId>com.mkt</groupId>
            <artifactId>platform-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mkt</groupId>
            <artifactId>platform-db</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mkt</groupId>
            <artifactId>domain-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mkt</groupId>
            <artifactId>domain-task</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mkt</groupId>
            <artifactId>domain-reward</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mkt</groupId>
            <artifactId>domain-risk</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mkt</groupId>
            <artifactId>domain-tracking</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mkt</groupId>
            <artifactId>domain-signin</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mkt</groupId>
            <artifactId>domain-activity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mkt</groupId>
            <artifactId>domain-ad</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
