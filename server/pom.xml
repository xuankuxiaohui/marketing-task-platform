<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.mkt</groupId>
    <artifactId>platform-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>platform-parent</name>
    <description>营销任务平台后端父 POM。第三方版本只来自 .kiro/specs/platform-v2/dependency-matrix.md。</description>

    <modules>
        <module>platform-kernel</module>
        <module>platform-contract</module>
        <module>platform-db</module>
        <module>platform-infra</module>
        <module>domain-identity</module>
        <module>domain-task</module>
        <module>domain-reward</module>
        <module>domain-risk</module>
        <module>domain-tracking</module>
        <module>admin-app</module>
        <module>portal-app</module>
    </modules>

    <properties>
        <java.version>26</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- dependency-matrix.md（任务 1–8 锁定） -->
        <redisson.version>4.6.1</redisson.version>
        <sa-token.version>1.45.0</sa-token.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <springdoc.version>3.1.0</springdoc.version>
        <aviator.version>5.4.3</aviator.version>
        <hutool.version>5.8.47</hutool.version>
        <easy-captcha.version>1.6.2</easy-captcha.version>
        <jqwik.version>1.9.3</jqwik.version>
        <archunit.version>1.5.0</archunit.version>
        <logstash-logback-encoder.version>8.1</logstash-logback-encoder.version>
        <!-- jacoco prepare-agent writes argLine; default empty so surefire still starts -->
        <argLine/>
        <jacoco.line.bundle.minimum>0.70</jacoco.line.bundle.minimum>
        <jacoco.line.critical.minimum>0.85</jacoco.line.critical.minimum>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.mkt</groupId>
                <artifactId>platform-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mkt</groupId>
                <artifactId>platform-kernel</artifactId>
                <version>${project.version}</version>
                <classifier>tests</classifier>
            </dependency>
            <dependency>
                <groupId>com.mkt</groupId>
                <artifactId>platform-contract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mkt</groupId>
                <artifactId>platform-db</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mkt</groupId>
                <artifactId>platform-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mkt</groupId>
                <artifactId>domain-identity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mkt</groupId>
                <artifactId>domain-task</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mkt</groupId>
                <artifactId>domain-reward</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mkt</groupId>
                <artifactId>domain-risk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mkt</groupId>
                <artifactId>domain-tracking</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot4-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-template</artifactId>
                <version>${sa-token.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.googlecode.aviator</groupId>
                <artifactId>aviator</artifactId>
                <version>${aviator.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-core</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-crypto</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.whvcse</groupId>
                <artifactId>easy-captcha</artifactId>
                <version>${easy-captcha.version}</version>
            </dependency>
            <dependency>
                <groupId>net.jqwik</groupId>
                <artifactId>jqwik</artifactId>
                <version>${jqwik.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*PropertyTest.java</include>
                            <include>**/*ArchTest.java</include>
                        </includes>
                        <excludes>
                            <exclude>**/*IT.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>**/*IT.java</include>
                        </includes>
                        <failIfNoTests>false</failIfNoTests>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.15</version>
                    <configuration>
                        <rules>
                            <rule>
                                <element>BUNDLE</element>
                                <limits>
                                    <limit>
                                        <counter>LINE</counter>
                                        <value>COVEREDRATIO</value>
                                        <minimum>${jacoco.line.bundle.minimum}</minimum>
                                    </limit>
                                </limits>
                            </rule>
                            <rule>
                                <element>PACKAGE</element>
                                <includes>
                                    <include>com.mkt.kernel</include>
                                    <include>com.mkt.task.engine</include>
                                    <include>com.mkt.task.expression</include>
                                    <include>com.mkt.reward.grant</include>
                                    <include>com.mkt.reward.points</include>
                                    <include>com.mkt.risk.engine</include>
                                </includes>
                                <limits>
                                    <limit>
                                        <counter>LINE</counter>
                                        <value>COVEREDRATIO</value>
                                        <minimum>${jacoco.line.critical.minimum}</minimum>
                                    </limit>
                                </limits>
                            </rule>
                        </rules>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-matrix-and-ban-antiselect</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[26,27)</version>
                                </requireJavaVersion>
                                <banDuplicatePomDependencyVersions/>
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <message>直接依赖必须是 dependency-matrix 已登记坐标、Boot BOM 或本仓库 com.mkt 模块</message>
                                    <excludes>
                                        <exclude>com.mkt:*</exclude>
                                        <exclude>org.springframework.boot:*</exclude>
                                        <exclude>org.springframework.security:spring-security-crypto</exclude>
                                        <exclude>org.redisson:redisson</exclude>
                                        <exclude>org.redisson:redisson-spring-boot-starter</exclude>
                                        <exclude>cn.dev33:sa-token-spring-boot4-starter</exclude>
                                        <exclude>cn.dev33:sa-token-redis-template</exclude>
                                        <exclude>com.baomidou:mybatis-plus-spring-boot4-starter</exclude>
                                        <exclude>org.springdoc:springdoc-openapi-starter-webmvc-ui</exclude>
                                        <exclude>com.googlecode.aviator:aviator</exclude>
                                        <exclude>cn.hutool:hutool-core</exclude>
                                        <exclude>cn.hutool:hutool-crypto</exclude>
                                        <exclude>com.github.whvcse:easy-captcha</exclude>
                                        <exclude>net.jqwik:jqwik</exclude>
                                        <exclude>com.tngtech.archunit:archunit-junit5</exclude>
                                        <exclude>net.logstash.logback:logstash-logback-encoder</exclude>
                                        <exclude>org.flywaydb:flyway-mysql</exclude>
                                        <exclude>com.mysql:mysql-connector-j</exclude>
                                        <exclude>org.testcontainers:testcontainers-junit-jupiter</exclude>
                                        <exclude>org.testcontainers:testcontainers-mysql</exclude>
                                        <exclude>com.github.ben-manes.caffeine:caffeine</exclude>
                                        <exclude>org.springframework:spring-tx</exclude>
                                    </excludes>
                                    <includes>
                                        <include>*:*</include>
                                    </includes>
                                </bannedDependencies>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <message>禁止反选型坐标（H2 / Hutool JSON·HTTP·DB / XXL-Job / Drools / Spring Cloud / RuoYi）</message>
                                    <includes>
                                        <include>com.h2database:*</include>
                                        <include>cn.hutool:hutool-json</include>
                                        <include>cn.hutool:hutool-http</include>
                                        <include>cn.hutool:hutool-db</include>
                                        <include>cn.hutool:hutool-all</include>
                                        <include>com.xuxueli:*</include>
                                        <include>org.drools:*</include>
                                        <include>org.kie:*</include>
                                        <include>org.springframework.cloud:*</include>
                                        <include>com.ruoyi:*</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
