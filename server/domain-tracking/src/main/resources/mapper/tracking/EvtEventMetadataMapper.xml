<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mkt.tracking.mapper.EvtEventMetadataMapper">

    <sql id="cols">
        id, event_code, name, prop_schema, status, owner, remark, created_at, updated_at
    </sql>

    <sql id="queryWhere">
        <where>
            <if test="eventCode != null and eventCode != ''">
                AND event_code = #{eventCode}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </sql>

    <select id="selectCountByQuery" resultType="long">
        SELECT COUNT(*)
        FROM evt_event_metadata
        <include refid="queryWhere"/>
    </select>

    <select id="selectByQuery" resultType="com.mkt.tracking.entity.EvtEventMetadataEntity">
        SELECT <include refid="cols"/>
        FROM evt_event_metadata
        <include refid="queryWhere"/>
        ORDER BY id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>
</mapper>
