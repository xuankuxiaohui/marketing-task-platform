<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mkt.task.mapper.TaskStepMapper">

    <select id="selectByTaskId" resultType="com.mkt.task.entity.TaskStepEntity">
        SELECT id, task_id, seq, code, name, type, progress_target, prize_id
        FROM task_step
        WHERE task_id = #{taskId}
        ORDER BY seq ASC, id ASC
    </select>

    <delete id="deleteByTaskId">
        DELETE FROM task_step WHERE task_id = #{taskId}
    </delete>
</mapper>
