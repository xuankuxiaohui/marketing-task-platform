# Copy to deploy/.env (gitignored). Placeholders only — never commit real secrets (R31.6).
# Injected as environment variables. REDIS_DATABASE MUST be 2 (shared-instance db0/db1 are other apps).

SPRING_PROFILES_ACTIVE=prod

# Host-published ports (MUST NOT bind 3308 / 6379 / 8080 / 8081)
NGINX_HTTP_PORT=18080
PROMETHEUS_PORT=19090

# MySQL 8 (compose service mysql:3306)
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_DATABASE=mkt_platform
MYSQL_USER=mkt
MYSQL_PASSWORD=CHANGE_ME_APP

# JDBC (apps). characterEncoding MUST be UTF-8 (Java charset). Connector/J rejects utf8mb4.
# MySQL server charset stays utf8mb4 (mysqld / mkt.cnf). Compose DNS: mysql / redis
MKT_DATASOURCE_URL=jdbc:mysql://mysql:3306/mkt_platform?characterEncoding=UTF-8&connectionTimeZone=UTC
MKT_DATASOURCE_USERNAME=mkt
MKT_DATASOURCE_PASSWORD=CHANGE_ME_APP

# Flyway account (admin-app only). portal MKT_FLYWAY_ENABLED stays false.
MKT_FLYWAY_USER=mkt_flyway
MKT_FLYWAY_PASSWORD=CHANGE_ME_FLYWAY
MKT_FLYWAY_ENABLED=false

# Redis 7 (compose). Short names map to MKT_REDIS_* in the process env.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS
REDIS_DATABASE=2
MKT_REDIS_HOST=redis
MKT_REDIS_PORT=6379
MKT_REDIS_PASSWORD=CHANGE_ME_REDIS
MKT_REDIS_DATABASE=2

# Session is Redis-backed (not JWT). Placeholder kept so the env inventory is complete (14-deployment §3.1).
MKT_SA_TOKEN_JWT_SECRET=CHANGE_ME_SESSION

# Super-admin first boot only; remove after hash is written (design §3.1).
MKT_INIT_ADMIN_PASSWORD=CHANGE_ME_Admin1n!

# 64-char hex AES-256-GCM master key for sys_internal_app secrets.
MKT_INTERNAL_APP_AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional alert webhook (NFR observability 3). Empty = log + metrics only.
MKT_ALERT_WEBHOOK_URL=
