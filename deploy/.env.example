# Shared middleware on the LAN VM. Copy to deploy/.env and fill secrets.
# deploy/.env is gitignored.

MYSQL_HOST=192.168.88.149
MYSQL_PORT=3308
MYSQL_DATABASE=mkt_platform
MYSQL_USERNAME=mkt
MYSQL_PASSWORD=

# admin-app: jdbc url / user / password (empty password_hash until this is set)
MKT_DATASOURCE_URL=jdbc:mysql://192.168.88.149:3308/mkt_platform?characterEncoding=utf8&connectionTimeZone=UTC
MKT_DATASOURCE_USERNAME=mkt
MKT_DATASOURCE_PASSWORD=
MKT_INIT_ADMIN_PASSWORD=

# AES-256 key as 64 hex chars. Encrypts sys_internal_app secrets (R15.2).
MKT_INTERNAL_APP_AES_KEY=

REDIS_HOST=192.168.88.149
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=2
